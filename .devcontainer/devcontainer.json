{
  "name": "Lean 4 (development)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "mounts": [
    "source=${localEnv:HOME}/.cache/mathlib,target=/home/vscode/.cache/mathlib,type=bind"
  ],
  "containerEnv": {
    "MATHLIB_CACHE_DIR": "/home/vscode/.cache/mathlib",
    "MATHLIB_NO_CACHE_ON_UPDATE": "1"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22.12"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4"
      ],
      "settings": {
        "lean4.serverEnv": {
          "PATH": "${containerEnv:PATH}"
        },
        "editor.unicodeHighlight.ambiguousCharacters": false
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}